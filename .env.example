# Database connection string (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/globetrotter?schema=public"
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/globetrotter?schema=public"

# JWT & Authentication Secret
JWT_SECRET="replace-with-a-secure-random-32-character-secret-in-production"
AUTH_SECRET="replace-with-a-secure-random-32-character-secret"

# Next.js Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional AI / LLM API configuration
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_BASE_URL="https://api.openai.com/v1"
